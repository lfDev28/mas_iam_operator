# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS builder

WORKDIR /src
COPY tools/mas-iam-installer/go.mod tools/mas-iam-installer/go.sum /src/tools/mas-iam-installer/
WORKDIR /src/tools/mas-iam-installer
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY tools/mas-iam-installer /src/tools/mas-iam-installer

ARG TARGETARCH=amd64
# Release builds stamp these (scripts/build-cli-image.sh passes them):
#   --build-arg VERSION=0.1.16 --build-arg COMMIT=<git sha> --build-arg BUILD_DATE=<UTC>
# VERSION may carry a leading "v". It must equal Version in
# internal/version/version.go, or be that value plus -rc.N for a release
# candidate: the in-cluster installer launches the Job image "v" + Version, so
# a tag that disagrees with the binary would launch the wrong image. Empty
# VERSION keeps version.go's value (local and dev builds).
ARG VERSION=""
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    source_version="$(sed -n 's/^[[:space:]]*Version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' internal/version/version.go)"; \
    if [ -z "${source_version}" ]; then \
      echo "error: cannot read Version from internal/version/version.go" >&2; exit 1; \
    fi; \
    version="${VERSION#v}"; \
    case "${version}" in \
      ""|"${source_version}"|"${source_version}"-rc.[0-9]*) ;; \
      *) echo "error: VERSION=${version} does not match version.go (${source_version}); bump version.go or fix the tag" >&2; exit 1 ;; \
    esac; \
    version="${version:-${source_version}}"; \
    pkg=github.com/lfDev28/mas_iam_operator/tools/mas-iam-installer/internal/version; \
    ldflags="-s -w -X ${pkg}.Version=${version} -X ${pkg}.Commit=${COMMIT} -X ${pkg}.BuildDate=${BUILD_DATE}"; \
    mkdir -p /out/bin; \
    for target in "darwin amd64" "darwin arm64" "linux amd64" "linux arm64"; do \
      set -- ${target}; \
      mkdir -p "/out/bin/$1-$2"; \
      CGO_ENABLED=0 GOOS="$1" GOARCH="$2" \
        go build -trimpath -ldflags="${ldflags}" -o "/out/bin/$1-$2/est" ./cmd/mas-iam-installer; \
    done; \
    echo "stamped mas-est ${version} (commit ${COMMIT}, built ${BUILD_DATE})"

ARG TARGETARCH=amd64
# Runtime base is the previous published mas-est image (multi-arch manifest,
# so podman picks the right per-arch variant automatically — no -${TARGETARCH}
# suffix needed). Pinned to v0.1.0-beta.9 because beta.10/11/12 were committed
# but never pushed to quay. The base only provides OS layers + the bootstrap
# layout; the est binary, scripts, manifests, and env directories are all
# rebuilt and re-copied below.
# Long-term we should drop the self-reference and base on a small OS image
# (ubi9-minimal or debian:bookworm-slim) so the chain isn't recursive.
FROM quay.io/lee_forster/mas-external-services-tool:v0.1.0-beta.9

ARG TARGETARCH=amd64

ENV MAS_EST_REPO_ROOT=/opt/mas-est
WORKDIR /opt/mas-est

COPY scripts /opt/mas-est/scripts
COPY manifests /opt/mas-est/manifests
COPY env /opt/mas-est/env
COPY --from=builder /out/bin /opt/mas-est/runtime/bin
COPY --from=builder /out/bin/linux-${TARGETARCH}/est /usr/local/bin/est

RUN ln -sf /usr/local/bin/est /usr/local/bin/mas-est \
    && chmod +x /usr/local/bin/est /opt/mas-est/scripts/*.sh

ENTRYPOINT ["est"]
CMD ["bootstrap"]
