# syntax=docker/dockerfile:1.7

FROM golang:1.25-bookworm AS builder

WORKDIR /src
COPY tools/mas-iam-installer/go.mod tools/mas-iam-installer/go.sum /src/tools/mas-iam-installer/
WORKDIR /src/tools/mas-iam-installer
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY tools/mas-iam-installer /src/tools/mas-iam-installer

ARG TARGETARCH=amd64
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out/bin \
    && for target in "darwin amd64" "darwin arm64" "linux amd64" "linux arm64"; do \
      set -- ${target}; \
      mkdir -p "/out/bin/$1-$2"; \
      CGO_ENABLED=0 GOOS="$1" GOARCH="$2" \
        go build -trimpath -ldflags="-s -w" -o "/out/bin/$1-$2/iam" ./cmd/mas-iam-installer; \
    done

FROM debian:bookworm-slim

ARG TARGETARCH=amd64
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      coreutils \
      curl \
      gettext-base \
      grep \
      openssl \
      ripgrep \
      sed \
      tar \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
      amd64) OCP_ARCH="x86_64" ;; \
      arm64) OCP_ARCH="aarch64" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/${OCP_ARCH}/clients/ocp/stable/openshift-client-linux.tar.gz" -o /tmp/openshift-client-linux.tar.gz \
    && tar -xzf /tmp/openshift-client-linux.tar.gz -C /usr/local/bin oc kubectl \
    && chmod +x /usr/local/bin/oc /usr/local/bin/kubectl \
    && rm -f /tmp/openshift-client-linux.tar.gz

ENV MAS_IAM_REPO_ROOT=/opt/mas-iam
WORKDIR /opt/mas-iam

COPY scripts /opt/mas-iam/scripts
COPY manifests /opt/mas-iam/manifests
COPY env /opt/mas-iam/env
COPY --from=builder /out/bin /opt/mas-iam/runtime/bin
COPY --from=builder /out/bin/linux-${TARGETARCH}/iam /usr/local/bin/iam

RUN ln -sf /usr/local/bin/iam /usr/local/bin/mas-iam-installer \
    && chmod +x /usr/local/bin/iam /opt/mas-iam/scripts/*.sh

ENTRYPOINT ["iam"]
CMD ["bootstrap"]
