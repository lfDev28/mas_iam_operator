# Copy this file to env/scim-bridge.env.local and fill in values.
# Do NOT commit the .local file to git.
#
# Image / deployment
SCIM_BRIDGE_IMAGE=quay.io/<org>/scim-bridge:dev
SCIM_BRIDGE_NAMESPACE=iam
# For release manifests: set SCIM_BRIDGE_IMAGE to the published Quay tag and run
#   ./scripts/scim-bridge-04-render-install-manifest.sh
# Optional: force container CLI (auto-detects docker/podman if unset)
# SCIM_BRIDGE_CONTAINER_CLI=podman
# Storage for the bridge state uses a PVC without an explicit StorageClass.
# Ensure your cluster has a default StorageClass set.
# Optional: force build platform (default linux/amd64 for cluster nodes)
# SCIM_BRIDGE_TARGET_OS=linux
# SCIM_BRIDGE_TARGET_ARCH=amd64
# Optional: imagePullSecrets in YAML form (default [])
# SCIM_BRIDGE_IMAGE_PULL_SECRETS=[]

# Keycloak
# If route cert automation is enabled, this can be derived from SCIM_BRIDGE_KEYCLOAK_ROUTE_HOST.
SCIM_BRIDGE_KEYCLOAK_BASE_URL=https://mas-iam-sample-iam.apps.masapmonitor.cp.fyre.ibm.com
SCIM_BRIDGE_KEYCLOAK_REALM=maximo
SCIM_BRIDGE_KEYCLOAK_CLIENT_ID=scim-admin
SCIM_BRIDGE_KEYCLOAK_CLIENT_SECRET=changeme # the deploy script + bootstrap Job will set this secret on the Keycloak client
# Optional CA bundle for Keycloak (recommended for prod)
# SCIM_BRIDGE_KEYCLOAK_CA_FILE=/etc/scim-bridge/certs/keycloak-ca.crt
# Dev-only: skip TLS verification (do not use in prod)
SCIM_BRIDGE_KEYCLOAK_INSECURE_SKIP_VERIFY=false
SCIM_BRIDGE_KEYCLOAK_RELEASE=mas-iam-sample
# Namespace where Keycloak is deployed (defaults to SCIM_BRIDGE_NAMESPACE)
# SCIM_BRIDGE_KEYCLOAK_NAMESPACE=iam
# Keycloak internal service name (defaults to SCIM_BRIDGE_KEYCLOAK_RELEASE; MAS chart uses <release> as the Service name)
# SCIM_BRIDGE_KEYCLOAK_SERVICE=mas-iam-sample
# Keycloak image for in-cluster bootstrap Job (deploy script auto-detects if unset)
# SCIM_BRIDGE_KEYCLOAK_IMAGE=quay.io/<org>/mas-iam-keycloak:<tag>
# Provision the scim-admin client/roles in Keycloak (recommended)
SCIM_BRIDGE_PROVISION_KEYCLOAK=true
# Provisioning method:
#   job    = in-cluster Kubernetes Job (default, recommended)
#   script = local oc exec via scripts/configure-scim-client.sh (advanced)
#   none   = do not provision; manage Keycloak manually (advanced)
# SCIM_BRIDGE_KEYCLOAK_BOOTSTRAP_METHOD=job
# Job name (delete the Job to force a re-run)
# SCIM_BRIDGE_KEYCLOAK_BOOTSTRAP_JOB_NAME=scim-bridge-keycloak-bootstrap
# Wait for the Job to complete when deploying via scim-bridge-02-deploy.sh
# SCIM_BRIDGE_KEYCLOAK_BOOTSTRAP_WAIT=true
# Optional: also grant scim-managed to the client service account
# SCIM_BRIDGE_KEYCLOAK_ASSIGN_MANAGED_ROLE=false
# Auto-provision a custom Route TLS cert + CA bundle for the Keycloak route (recommended).
SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_ENABLE=true
# Job name (delete the Job to force a re-run)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_JOB_NAME=scim-bridge-keycloak-route-cert
# Image with oc + openssl (default uses OpenShift CLI image)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_IMAGE=registry.redhat.io/openshift4/ose-cli
# Wait for the Job to complete when deploying via scim-bridge-02-deploy.sh
# SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_WAIT=true
# Route namespace/name (defaults to Keycloak release namespace + scim-bridge-keycloak route name)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_NAMESPACE=iam
# SCIM_BRIDGE_KEYCLOAK_ROUTE_NAME=scim-bridge-keycloak
# Optional: override route host (otherwise fetched from the Route)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_HOST=mas-iam-sample-iam.apps.example.com
# Route used to discover the cluster's base domain when computing SCIM_BRIDGE_KEYCLOAK_ROUTE_HOST
# SCIM_BRIDGE_KEYCLOAK_ROUTE_DOMAIN_SOURCE=mas-iam-sample
# Target service for the new Route (defaults to SCIM_BRIDGE_KEYCLOAK_SERVICE)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_SERVICE=mas-iam-sample
# CA secret to persist the signing keypair (stored in the Keycloak namespace)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_CA_SECRET=scim-bridge-route-ca
# Route certificate validity period (days)
# SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_DAYS=825

# MAS SCIM
SCIM_BRIDGE_MAS_BASE_URL=https://api.<mas-instance>.<domain>/scim/v2
SCIM_BRIDGE_MAS_PROFILE_ID=demo
# Map Keycloak masProfile labels to MAS profile IDs (optional)
SCIM_BRIDGE_MAS_PROFILE_MAP=users=demo,management=mgmt1
# SCIM_BRIDGE_MAS_PROFILE_MAP_JSON={"users":"test1","management":"mgmt1"}
SCIM_BRIDGE_MAS_PROFILE_REQUIRE_LABEL=false
SCIM_BRIDGE_MAS_AUTH_TYPE=jwt
# Optional CA bundle for MAS (recommended for prod)
# SCIM_BRIDGE_MAS_CA_FILE=/etc/scim-bridge/certs/mas-ca.crt
# Dev-only: skip TLS verification (do not use in prod)
SCIM_BRIDGE_MAS_INSECURE_SKIP_VERIFY=false
# Option A: direct SCIM token
# SCIM_BRIDGE_MAS_TOKEN=...
# Option B: on-demand token via /v1/authenticate
SCIM_BRIDGE_MAS_API_TOKEN_NAME=a-lfmas-...
SCIM_BRIDGE_MAS_API_TOKEN_VALUE=changeme

# Optional: bootstrap a MAS SCIM profile named "demo" during install
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_ENABLED=false
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_ID=demo
# Workspace ID for the demo profile payload (required unless JSON is provided)
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_WORKSPACE_ID=workspace
# Optional: full SCIM profile JSON payload (overrides workspace-based template).
# Default template is local-only identity and "manage" app for portability.
# Add SAML identities/apps here only if they exist in your MAS tenant.
# SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_JSON={"id":"demo","version":1,"identities":[{"type":"local"}],"entitlement":{"application":"PREMIUM","admin":"ADMIN_PREMIUM"},"workspaces":[{"id":"workspace","applications":["manage"]}]}
# Optional: override bootstrap Job settings
# SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_JOB_NAME=scim-bridge-mas-profile-bootstrap
# SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_IMAGE=curlimages/curl:8.5.0

# Bridge behavior
SCIM_BRIDGE_BRIDGE_MODE=poll
SCIM_BRIDGE_BRIDGE_POLL_INTERVAL=5m
SCIM_BRIDGE_BRIDGE_STATE_BACKEND=filesystem
SCIM_BRIDGE_BRIDGE_STATE_PATH=/var/lib/scim-bridge/state.json
SCIM_BRIDGE_BRIDGE_ALLOW_UPDATES=true
SCIM_BRIDGE_BRIDGE_DRY_RUN=false
# Optional filters
# SCIM_BRIDGE_INCLUDE_USERNAMES=demo_saml_user1,demo_saml_user2
# SCIM_BRIDGE_INCLUDE_USERNAME_PREFIX=demo_

# MAS curl helper (mas-scim-curl.sh)
MAS_SCIM_BASE=https://api.<mas-instance>.<domain>/scim/v2
MAS_PROFILE_ID=demo
MAS_AUTH_SCHEME=Bearer
# MAS_TOKEN=...           # if you prefer to set token directly
API_TOKEN_NAME=a-lfmas-...
API_TOKEN_VALUE=changeme

# Mongo helper (optional)
MONGO_NAMESPACE=mongoce
MONGO_INSTANCE=mas-mongo-ce
