# Release defaults for rendering manifests/scim-bridge-install.yaml
# Maintainers: update image tags and any defaults before publishing.

# Images
SCIM_BRIDGE_IMAGE=quay.io/lee_forster/mas-iam-scim-bridge:scim-bridge-v0.1.0
SCIM_BRIDGE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.5

# Namespaces / Keycloak
SCIM_BRIDGE_NAMESPACE=iam
SCIM_BRIDGE_KEYCLOAK_RELEASE=mas-iam-sample
SCIM_BRIDGE_KEYCLOAK_NAMESPACE=iam
SCIM_BRIDGE_KEYCLOAK_SERVICE=mas-iam-sample
SCIM_BRIDGE_KEYCLOAK_BASE_URL=https://keycloak.example.com
SCIM_BRIDGE_KEYCLOAK_REALM=maximo
SCIM_BRIDGE_KEYCLOAK_CLIENT_ID=scim-admin
SCIM_BRIDGE_KEYCLOAK_CLIENT_SECRET=CHANGEME
SCIM_BRIDGE_KEYCLOAK_ASSIGN_MANAGED_ROLE=false
SCIM_BRIDGE_PROVISION_KEYCLOAK=true

# Route cert bootstrap
SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_ENABLE=true
SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_IMAGE=registry.redhat.io/openshift4/ose-cli
SCIM_BRIDGE_KEYCLOAK_ROUTE_NAMESPACE=iam
SCIM_BRIDGE_KEYCLOAK_ROUTE_NAME=scim-bridge-keycloak
SCIM_BRIDGE_KEYCLOAK_ROUTE_SERVICE=mas-iam-sample
SCIM_BRIDGE_KEYCLOAK_ROUTE_CA_SECRET=scim-bridge-route-ca
SCIM_BRIDGE_KEYCLOAK_ROUTE_CERT_DAYS=825
SCIM_BRIDGE_KEYCLOAK_ROUTE_DOMAIN_SOURCE=mas-iam-sample

# MAS SCIM defaults (operators should edit in OCP)
SCIM_BRIDGE_MAS_BASE_URL=https://api.<mas-instance>.<domain>/scim/v2
SCIM_BRIDGE_MAS_PROFILE_ID=demo
SCIM_BRIDGE_MAS_PROFILE_MAP=
SCIM_BRIDGE_MAS_PROFILE_MAP_JSON=
SCIM_BRIDGE_MAS_PROFILE_REQUIRE_LABEL=false
SCIM_BRIDGE_MAS_AUTH_TYPE=jwt
SCIM_BRIDGE_MAS_TOKEN=
SCIM_BRIDGE_MAS_API_TOKEN_NAME=CHANGEME
SCIM_BRIDGE_MAS_API_TOKEN_VALUE=CHANGEME
SCIM_BRIDGE_MAS_INSECURE_SKIP_VERIFY=false
SCIM_BRIDGE_MAS_CA_FILE=
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_ENABLED=false
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_ID=demo
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_WORKSPACE_ID=workspace
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_JSON=
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_JOB_NAME=scim-bridge-mas-profile-bootstrap
SCIM_BRIDGE_MAS_PROFILE_BOOTSTRAP_IMAGE=curlimages/curl:8.5.0

# Bridge
SCIM_BRIDGE_BRIDGE_MODE=poll
SCIM_BRIDGE_BRIDGE_POLL_INTERVAL=5m
SCIM_BRIDGE_BRIDGE_STATE_BACKEND=filesystem
SCIM_BRIDGE_BRIDGE_STATE_PATH=/var/lib/scim-bridge/state.json
SCIM_BRIDGE_BRIDGE_ALLOW_UPDATES=true
SCIM_BRIDGE_BRIDGE_DRY_RUN=false
SCIM_BRIDGE_INCLUDE_USERNAMES=
SCIM_BRIDGE_INCLUDE_USERNAME_PREFIX=

# Storage
# Leave empty to use the cluster default StorageClass.
SCIM_BRIDGE_STORAGE_CLASS=

# Image pull secrets (YAML list or empty)
SCIM_BRIDGE_IMAGE_PULL_SECRETS=[]
