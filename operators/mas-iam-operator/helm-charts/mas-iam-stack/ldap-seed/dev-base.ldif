dn: ou=users,dc=demo,dc=local
objectClass: organizationalUnit
ou: users

# Groups branch
dn: ou=groups,dc=demo,dc=local
objectClass: organizationalUnit
ou: groups

# Demo groups
dn: cn=ldap-users,ou=groups,dc=demo,dc=local
objectClass: groupOfUniqueNames
cn: ldap-users
uniqueMember: cn=ldap.user1,ou=users,dc=demo,dc=local
uniqueMember: cn=ldap.user2,ou=users,dc=demo,dc=local


dn: cn=ldap-admins,ou=groups,dc=demo,dc=local
objectClass: groupOfUniqueNames
cn: ldap-admins
uniqueMember: cn=ldap.user1,ou=users,dc=demo,dc=local

# Users
# Two demo users intended to log in via the MAS LDAP identity provider.
# MAS creates the user record on first login via its LDAP self-registration
# path; the SCIM bridge skips them (its include-username-prefix is "scim.").

dn: cn=ldap.user1,ou=users,dc=demo,dc=local
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
cn: ldap.user1
sn: One
givenName: LDAP
uid: ldap.user1
mail: ldap.user1@demo.local
userPassword: @@PASSWORD{ldap.user1}@@


dn: cn=ldap.user2,ou=users,dc=demo,dc=local
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
cn: ldap.user2
sn: Two
givenName: LDAP
uid: ldap.user2
mail: ldap.user2@demo.local
userPassword: @@PASSWORD{ldap.user2}@@
